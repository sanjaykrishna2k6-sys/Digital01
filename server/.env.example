PORT=5000
MONGODB_URI=mongodb+srv://...
CLIENT_URL=http://localhost:5173
SESSION_SECRET=dev_session_secret
NODE_ENV=development
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=scalevo_token

# Shopify App Credentials (from Shopify Partner Dashboard > App Setup)
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_APP_URL=http://localhost:5000
SHOPIFY_SCOPES=read_products,read_orders,read_customers
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# Server-Side Token Encryption at Rest (32-byte hex key for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

